# Where the WhoOwes server lives. The URL is baked into builds, so set it before building.
#   Local server, testing on your phone: http://<your computer's Wi-Fi IP>:4000  (not localhost)
#   Production (Render):                 https://<your-service>.onrender.com
# Leave empty to run the self-contained demo on sample data.
EXPO_PUBLIC_API_URL=

# Rewarded ads that unlock extra AI uses: AdMob → Apps → Ad units → a Rewarded unit
# ("ca-app-pub-…/…"). Not secret. Unset (or in development) shows Google's test ad.
# Builds also need the AdMob *app* id as an EAS environment variable: ADMOB_ANDROID_APP_ID.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
# Later, for iPhone (and ADMOB_IOS_APP_ID).
EXPO_PUBLIC_ADMOB_REWARDED_IOS=

# Link in invite messages. Defaults to the Google Play listing; set it once WhoOwes has its own website.
EXPO_PUBLIC_INVITE_URL=
