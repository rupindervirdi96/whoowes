# Copy to .env for local development. Every value is optional locally.

PORT=4000
# Public URL of this server. On Render this is detected automatically.
PUBLIC_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────────────────────────
# Leave empty locally: an embedded Postgres (PGlite) is stored in data/pglite.
# On Render this is filled in from the database by render.yaml.
DATABASE_URL=

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string. Required in production; generated locally if empty.
AUTH_JWT_SECRET=

# ── Phone sign-in (Twilio Verify) ─────────────────────────────────────────
# https://console.twilio.com → Verify → Services → create one, copy its SID.
# Without these, local servers accept the code 123456 (printed in the log).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Claude (AI receipt reading, Quick Add, insights) ─────────────────────
ANTHROPIC_API_KEY=

# Development only: give every user this plan (free | plus | pro) to test AI
# features without Stripe. Ignored in production.
DEV_PLAN=pro

# ── Stripe (subscriptions) ───────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen` (local) or the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7
