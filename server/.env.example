# Copy to .env for local development. Every value is optional locally.

PORT=4000
# Public URL of this server. On Render this is detected automatically.
PUBLIC_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────────────────────────
# Leave empty locally: a local MongoDB starts automatically, stored in data/mongo
# (the first start downloads MongoDB once, a few hundred MB).
# In production: your MongoDB Atlas connection string (mongodb+srv://…).
MONGODB_URI=
# Database name inside the cluster (default: whoowes).
MONGODB_DB=

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string. Required in production; generated locally if empty.
AUTH_JWT_SECRET=

# ── Phone sign-in (Twilio Verify) ─────────────────────────────────────────
# https://console.twilio.com → Verify → Services → create one, copy its SID.
# Without these, local servers accept the code 123456 (printed in the log).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Claude (AI receipt reading, Quick Add, insights) ─────────────────────
ANTHROPIC_API_KEY=

# Development only: give every user this plan (free | plus | pro) to test AI
# features without Stripe. Ignored in production.
DEV_PLAN=pro

# ── Google Play / App Store subscriptions (RevenueCat) ───────────────────
# app.revenuecat.com → Project settings → API keys → a secret key (API v1).
REVENUECAT_SECRET_KEY=
# Any long random string; paste the same value as the webhook's Authorization header.
REVENUECAT_WEBHOOK_AUTH=

# ── App store review sign-in ─────────────────────────────────────────────
# Reviewers can't receive our texts. This number skips Twilio and accepts the
# code below. Use a number nobody owns (e.g. +15555550123). Empty = off.
REVIEW_PHONE=
REVIEW_CODE=

# Contact address shown on /privacy, /terms and /delete-account.
SUPPORT_EMAIL=

# ── Stripe (web subscriptions) ───────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen` (local) or the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7
