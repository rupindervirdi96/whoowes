{
  "expo": {
    "name": "WhoOwes",
    "slug": "whoowes",
    "scheme": "whoowes",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whoowes.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "WhoOwes uses the camera to scan receipts so you don't have to type every item.",
        "NSPhotoLibraryUsageDescription": "WhoOwes reads receipt photos you choose so it can split them for you.",
        "NSContactsUsageDescription": "WhoOwes checks your contacts to show which friends are already on WhoOwes. Numbers are hashed on your phone and never stored."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B4CF5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.whoowes.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0C1D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "WhoOwes uses the camera to scan receipts so you don't have to type every item.",
          "photosPermission": "WhoOwes reads receipt photos you choose so it can split them for you.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "WhoOwes checks your contacts to show which friends are already on WhoOwes. Numbers are hashed on your phone and never stored."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "5753ad65-ec30-418b-80ce-ff700d5ddb82"
      }
    }
  }
}
